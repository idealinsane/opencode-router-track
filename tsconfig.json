{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "jsx": "preserve",
    "noEmitOnError": true
  },
  "include": [
    "index.ts",
    "tui.tsx"
  ]
}
